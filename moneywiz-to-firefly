#!/usr/bin/env python
# -*- coding: utf-8 -*-
import logging
import sys

import click

from firefly.exporter import Exporter
from storage.transactions import TransactionsDB
from moneywiz.importer import CsvImporter
from moneywiz.analyzer import CsvAnalyzer


@click.command()
@click.option('--dbpath', default='.db', type=click.Path(exists=False), help='DB directory')
@click.option('--export/--import', default=False, help='Export or import mode', required=False)
@click.option('-v', default=False, is_flag=True, help='Verbose logging', required=False)
@click.argument('filename', type=click.Path(exists=True), required=False)
def cli(dbpath, export, v, filename):
    logging.getLogger("sqlalchemy.engine").setLevel(logging.DEBUG if v else logging.WARN)
    logging.basicConfig(format='%(asctime)s - %(levelname)s - %(message)s', level=logging.DEBUG if v else logging.INFO)
    logger = logging.getLogger(__name__)

    db = TransactionsDB(logger, dbpath).init()

    if not export:
        if filename is None:
            raise click.UsageError("The filename is required in the import mode.")

        importer = CsvImporter(logger)
        analyzer = CsvAnalyzer(logger, db)

        try:
            data = importer.parse(filename)
            analyzer.analyze(data)
            analyzer.commit()
        except Exception as e:
            logger.error(f'Failed to import CSV file: {e}')
            sys.exit(1)

    else:
        exporter = Exporter(logger, db)

        try:
            exporter.export()
        except Exception as e:
            logger.error(f'Failed to export to Firefly III: {e}')
            sys.exit(2)


# main block
if __name__ == '__main__':
    cli()
