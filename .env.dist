# Firefly III connection (used by the export mode of moneywiz-to-firefly)
FIREFLY_URL=
FIREFLY_TOKEN=

# Deployment settings (only needed if you use update_firefly.sh)
# NOTE: paths that should expand on the HOST (not locally) must be single-quoted,
# e.g. DEPLOY_PROJECT_DIR='$HOME/Development/moneywiz-to-firefly'
# SSH host to deploy to: "user@host" or a ~/.ssh/config alias
DEPLOY_SSH_HOST=
# Base directory on the host holding reports/, db/, and config.json
DEPLOY_REMOTE_PATH=
# Path to the moneywiz-to-firefly checkout on the host
DEPLOY_PROJECT_DIR=
# Dir to prepend to PATH on the host so `uv` is found (mise shims).
# Leave empty to use the host's login PATH as-is.
DEPLOY_PATH_PREFIX='$HOME/.local/share/mise/shims'
