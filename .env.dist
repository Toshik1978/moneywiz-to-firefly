# Firefly III connection (used by the export mode of moneywiz-to-firefly).
# Loaded by the Python CLI via load_dotenv(), so this file lives next to where
# the CLI runs (e.g. the checkout on the deploy host).
FIREFLY_URL=
FIREFLY_TOKEN=

